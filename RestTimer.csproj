<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>RestTimer.ico</ApplicationIcon>
    <Product>RestTimer</Product>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/VERSION').Trim())</Version>
    <Description>A Windows break timer with a synchronized overlay on every display.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs;build/**/*.cs;dist/**/*.cs" />
    <EmbeddedResource Include="CHANGELOG.md" />
    <EmbeddedResource Include="CHANGELOG.fa.md" WithCulture="false" LogicalName="RestTimer.CHANGELOG.fa.md" />
    <EmbeddedResource Include="locales/*.json" WithCulture="false" LogicalName="RestTimer.Locales.%(Filename)%(Extension)" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>
